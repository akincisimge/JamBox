# Vercel Project Settings > Environment Variables
NEXT_PUBLIC_API_URL=https://jambox-api.onrender.com/api
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Add the final Vercel callback URL to Spotify Developer Dashboard, for example:
# https://your-jambox-project.vercel.app/callback
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=https://your-jambox-project.vercel.app/callback

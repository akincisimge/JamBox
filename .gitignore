.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build outputs
.next/
dist/
/build/*
!/build/sites-vite-plugin.ts
.vinext/
.sites-runtime/
.wrangler/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# macOS
.DS_Store
# Local configuration
/.openai/*
!/.openai/hosting.json
.npmrc

